# Z-Shield AI — Render Docker deployment
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
# Install Python dependencies first to improve Docker layer caching.
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r ./backend/requirements.txt

# Copy the FastAPI backend and the frontend assets.
COPY backend/ ./backend/
COPY frontend/ ./frontend/
# Render provides PORT at runtime. The fallback keeps local Docker runs convenient.
EXPOSE 8000
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]